APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# JANGAN `true` di server produksi: pesan galat Laravel memuat kueri SQL,
# path berkas, dan nilai variabel lingkungan.
APP_DEBUG=false
APP_URL=http://localhost:8000

# Proxy/CDN tepercaya (dipisah koma), mis. "127.0.0.1,10.0.0.5".
# Biarkan kosong bila aplikasi diakses langsung: jangan pernah isi "*" karena
# header X-Forwarded-For bisa dipalsukan untuk melewati pembatas login.
TRUSTED_PROXIES=

# Nama domain yang boleh muncul pada header Host (dipisah koma), mis.
# "siapbosp.makassar.go.id,*.makassar.go.id". Kosong = hanya host APP_URL
# + subdomainnya. Isi bila aplikasi dilayani lewat beberapa domain/IP.
TRUSTED_HOSTS=

# Umur token API (hari). Token otomatis dicabut saat sandi berubah.
API_TOKEN_UMUR_HARI=180

# Sandi enkripsi backup (AES-256 di dalam ZIP). Kosong = tidak dienkripsi.
# Simpan sandi ini terpisah dari berkas backup.
BACKUP_PASSWORD=

# Batas penerima satu pengumuman Dinas (email massal).
PENGUMUMAN_MAKS_PENERIMA=3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Produksi: LOG_LEVEL=warning. Jejak audit disalin ke storage/logs/audit.log.
AUDIT_LOG_DAYS=365

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Produksi HTTPS: set SESSION_SECURE_COOKIE=true dan SESSION_ENCRYPT=true.
# Pada pemakaian lokal http:// (portabel), keduanya biarkan false.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Panduan SMTP sungguhan =====
# Ubah MAIL_MAILER log menjadi smtp, lalu isi kredensial, contoh Gmail:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=alamat-gmail-sekolah@gmail.com
#   MAIL_PASSWORD=<App Password 16 karakter dari myaccount.google.com/apppasswords>
# Selama nilainya log, email tercatat utuh di storage/logs/laravel.log (aman untuk demo).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
