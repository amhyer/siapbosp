<Application x:Class="SiapBOSP.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Warna brand ===== -->
            <Color x:Key="WarnaHijauTua">#155E3C</Color>
            <Color x:Key="WarnaHijau">#21A366</Color>
            <SolidColorBrush x:Key="BrushHijauTua" Color="#155E3C"/>
            <SolidColorBrush x:Key="BrushHijau" Color="#1E8E57"/>
            <SolidColorBrush x:Key="BrushHijauHover" Color="#177A4A"/>
            <SolidColorBrush x:Key="BrushHijauTekan" Color="#125F3A"/>
            <SolidColorBrush x:Key="BrushHijauMuda" Color="#E8F6EE"/>
            <SolidColorBrush x:Key="BrushLatar" Color="#F1F5F3"/>
            <SolidColorBrush x:Key="BrushTeks" Color="#334155"/>
            <SolidColorBrush x:Key="BrushTeksJudul" Color="#0F172A"/>
            <SolidColorBrush x:Key="BrushTeksRedup" Color="#64748B"/>
            <SolidColorBrush x:Key="BrushGaris" Color="#CBD5E1"/>
            <SolidColorBrush x:Key="BrushAbuNonaktif" Color="#CBD5E1"/>
            <SolidColorBrush x:Key="BrushMerah" Color="#B91C1C"/>
            <SolidColorBrush x:Key="BrushAmber" Color="#B45F06"/>
            <SolidColorBrush x:Key="BrushKuningLatar" Color="#FEF6E0"/>
            <SolidColorBrush x:Key="BrushKuningGaris" Color="#F2C46B"/>

            <LinearGradientBrush x:Key="BrushHeader" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#155E3C" Offset="0"/>
                <GradientStop Color="#21A366" Offset="1"/>
            </LinearGradientBrush>

            <!-- ===== Teks ===== -->
            <Style x:Key="TeksJudul" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushHijauTua}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="TeksSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTeksRedup}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="TeksLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTeks}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="TeksBantuan" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTeksRedup}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="TeksGalat" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMerah}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>

            <!-- ===== Tombol ===== -->
            <Style x:Key="FokusTombol">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border CornerRadius="9" Margin="-3" BorderThickness="2" BorderBrush="#7FD1A6"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoundedPrimary" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource BrushHijau}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FokusTombol}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Latar" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Latar" Property="Background" Value="{StaticResource BrushHijauHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Latar" Property="Background" Value="{StaticResource BrushHijauTekan}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Latar" Property="Background" Value="#A7C9B6"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoundedSecondary" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource BrushTeks}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushGaris}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FokusTombol}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Latar" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Latar" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="Latar" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Latar" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tombol teks kecil (mis. "Buka Log") -->
            <Style x:Key="TombolTautan" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource BrushHijauTua}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Latar" Background="{StaticResource BrushHijauMuda}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Latar" Property="Background" Value="#D3EEDF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Kotak isian ===== -->
            <ControlTemplate x:Key="TemplatIsian" TargetType="{x:Type Control}">
                <Border x:Name="Bingkai" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                  Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bingkai" Property="BorderBrush" Value="#94A3B8"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="Bingkai" Property="BorderBrush" Value="{StaticResource BrushHijau}"/>
                        <Setter TargetName="Bingkai" Property="BorderThickness" Value="2"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bingkai" Property="Background" Value="#F1F5F9"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="GayaIsian" TargetType="TextBox">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTeksJudul}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushGaris}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template" Value="{StaticResource TemplatIsian}"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource GayaIsian}"/>

            <Style TargetType="PasswordBox">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTeksJudul}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushGaris}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="PasswordChar" Value="*"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template" Value="{StaticResource TemplatIsian}"/>
            </Style>

            <!-- Kotak log: Consolas 9pt, hanya-baca, bisa digulir -->
            <Style x:Key="GayaLog" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#D1FAE5"/>
                <Setter Property="Background" Value="#0F2A1E"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,6">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Kotak centang ===== -->
            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTeks}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Kotak" Width="20" Height="20" CornerRadius="5" BorderThickness="1.5"
                                        BorderBrush="#94A3B8" Background="White" VerticalAlignment="Center">
                                    <Path x:Name="Centang" Data="M4.5,10 L8.5,14 L15.5,6" Stroke="White" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Kotak" Property="Background" Value="{StaticResource BrushHijau}"/>
                                    <Setter TargetName="Kotak" Property="BorderBrush" Value="{StaticResource BrushHijau}"/>
                                    <Setter TargetName="Centang" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Kotak" Property="BorderBrush" Value="{StaticResource BrushHijauTua}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Bilah progres membulat (mendukung mode tak-tentu) ===== -->
            <Style x:Key="ProgresBulat" TargetType="ProgressBar">
                <Setter Property="Height" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource BrushHijau}"/>
                <Setter Property="Background" Value="#E2E8F0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="6"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1E8E57" Offset="0"/>
                                            <GradientStop Color="#34C47F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid x:Name="Lapisan" ClipToBounds="True" Visibility="Collapsed">
                                    <Border x:Name="Kilat" Width="160" HorizontalAlignment="Left" CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0021A366" Offset="0"/>
                                                <GradientStop Color="#FF21A366" Offset="0.5"/>
                                                <GradientStop Color="#0021A366" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-160"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Lapisan" Property="Visibility" Value="Visible"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="AnimasiKilat">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Kilat" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="-160" To="720" Duration="0:0:1.6"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="AnimasiKilat"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Kartu halaman: bayangan di lapisan terpisah agar teks tetap ClearType ===== -->
            <Style x:Key="Kartu" TargetType="ContentControl">
                <Setter Property="Margin" Value="20,16,20,4"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid>
                                <Border Background="White" CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Opacity="0.12" ShadowDepth="2" Direction="270" Color="#0F172A"/>
                                    </Border.Effect>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="24">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Indikator langkah ===== -->
            <Style x:Key="TitikLangkah" TargetType="Ellipse">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Fill" Value="{StaticResource BrushAbuNonaktif}"/>
            </Style>

            <!-- Butir daftar dengan centang (halaman Selamat datang) -->
            <Style x:Key="IkonCentang" TargetType="Path">
                <Setter Property="Data" Value="M3.5,8.5 L6.8,11.8 L12.5,5"/>
                <Setter Property="Stroke" Value="{StaticResource BrushHijau}"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="0,1,10,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
